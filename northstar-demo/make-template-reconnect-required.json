    {
      "id": 9,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": {},
      "mapper": {
        "key": "{{1.submission_id}}",
        "data": {
          "owner": "{{2.owner}}",
          "status": "completed",
          "sheet_row": "{{5.rowNumber}}",
