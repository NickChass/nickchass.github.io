{
  "name": "Northstar enquiry intake \u2014 RECONNECT BEFORE USE",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ],
        "interface": [
          {
            "help": "",
            "name": "submission_id",
            "type": "text",
            "label": "Submission ID",
            "default": null,
            "required": true,
            "multiline": false
          },
          {
            "help": "",
            "name": "submitted_at",
            "type": "text",
            "label": "Submitted at"
          },
          {
            "help": "",
            "name": "name",
            "type": "text",
            "label": "Name"
          },
          {
            "help": "",
            "name": "email",
            "type": "text",
            "label": "Email",
            "default": null,
            "required": true,
            "multiline": false
          },
          {
            "help": "",
            "name": "company",
            "type": "text",
            "label": "Company"
          },
          {
            "help": "",
            "name": "service",
            "type": "text",
            "label": "Service"
          },
          {
            "help": "",
            "name": "message",
            "type": "text",
            "label": "Message"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "normalized_email",
            "value": "{{lower(trim(1.email))}}"
          },
          {
            "name": "owner",
            "value": "{{switch(1.service; \"website_build\"; \"Maya\"; \"website_care\"; \"Theo\"; \"manual-review\")}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "expect": [
          {
            "name": "variables",
            "spec": {
              "name": "value",
              "spec": [
                {
                  "name": "name",
                  "type": "text",
                  "label": "Variable name",
                  "required": true
                },
                {
                  "name": "value",
                  "type": "any",
                  "label": "Variable value"
                }
              ],
              "type": "collection",
              "label": "Variable"
            },
            "type": "array",
            "label": "Variables",
            "validate": {
              "unique": {
                "by": "name"
              },
              "minItems": 1
            }
          }
        ],
        "interface": [
          {
            "name": "normalized_email",
            "type": "any",
            "label": "normalized_email"
          },
          {
            "name": "owner",
            "type": "any",
            "label": "owner"
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "datastore:ExistRecord",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Valid enquiry \u2014 ID and basic email shape",
        "conditions": [
          [
            {
              "a": "{{length(trim(1.submission_id))}}",
              "b": "0",
              "o": "number:greater"
            },
            {
              "a": "{{2.normalized_email}}",
              "b": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "o": "text:pattern"
            }
          ]
        ]
      },
      "mapper": {
        "key": "{{1.submission_id}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "parameters": [
          {
            "name": "datastore",
            "type": "datastore",
            "label": "Data store",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "key",
            "type": "text",
            "label": "Key",
            "required": true
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "datastore:AddRecord",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "New submission only \u2014 ledger exists is false",
        "conditions": [
          [
            {
              "a": "{{3.exist}}",
              "o": "boolean:isfalse"
            }
          ]
        ]
      },
      "mapper": {
        "key": "{{1.submission_id}}",
        "data": {
          "owner": "{{2.owner}}",
          "status": "processing",
          "sheet_row": "",
          "updated_at": "{{formatDate(now; \"YYYY-MM-DDTHH:mm:ss[Z]\"; \"UTC\")}}"
        },
        "overwrite": false
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "parameters": [
          {
            "name": "datastore",
            "type": "datastore",
            "label": "Data store",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "key",
            "type": "text",
            "label": "Key"
          },
          {
            "name": "overwrite",
            "type": "boolean",
            "label": "Overwrite an existing record",
            "required": true
          },
          {
            "name": "data",
            "spec": [
              {
                "name": "status",
                "type": "text",
                "label": "Status"
              },
              {
                "name": "owner",
                "type": "text",
                "label": "Owner"
              },
              {
                "name": "sheet_row",
                "type": "number",
                "label": "Sheet row"
              },
              {
                "name": "updated_at",
                "type": "text",
                "label": "Updated at"
              }
            ],
            "type": "collection",
            "label": "Record"
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "mode": "fromAll",
        "values": {
          "name": "{{trim(1.name)}}",
          "email": "{{2.normalized_email}}",
          "owner": "{{2.owner}}",
          "company": "{{1.company}}",
          "message": "{{1.message}}",
          "service": "{{1.service}}",
          "submitted_at": "{{1.submitted_at}}",
          "intake_status": "notification_pending",
          "submission_id": "{{1.submission_id}}"
        },
        "sheetId": "Enquiries",
        "spreadsheetId": "REPLACE_WITH_SPREADSHEET_ID",
        "includesHeaders": true,
        "insertDataOption": "INSERT_ROWS",
        "useColumnHeaders": true,
        "valueInputOption": "RAW",
        "insertUnformatted": false
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "mode",
            "type": "select",
            "label": "Search Method",
            "required": true,
            "validate": {
              "enum": [
                "select",
                "fromAll",
                "map"
              ]
            }
          },
          {
            "name": "insertUnformatted",
            "type": "boolean",
            "label": "Unformatted",
            "required": true
          },
          {
            "name": "valueInputOption",
            "type": "select",
            "label": "Value input option",
            "required": true,
            "validate": {
              "enum": [
                "USER_ENTERED",
                "RAW"
              ]
            }
          },
          {
            "name": "insertDataOption",
            "type": "select",
            "label": "Insert data option",
            "validate": {
              "enum": [
                "INSERT_ROWS",
                "OVERWRITE"
              ]
            }
          },
          {
            "name": "spreadsheetId",
            "type": "text",
            "label": "Spreadsheet ID",
            "required": true
          },
          {
            "name": "sheetId",
            "type": "select",
            "label": "Sheet Name",
            "required": true
          },
          {
            "name": "includesHeaders",
            "type": "select",
            "label": "Table contains headers",
            "required": true,
            "validate": {
              "enum": [
                true,
                false
              ]
            }
          },
          {
            "name": "useColumnHeaders",
            "type": "select",
            "label": "Use column headers as IDs of the columns",
            "required": true,
            "validate": {
              "enum": [
                true,
                false
              ]
            }
          },
          {
            "name": "values",
            "spec": [
              {
                "name": "submission_id",
                "type": "text",
                "label": "submission_id (A)"
              },
              {
                "name": "submitted_at",
                "type": "text",
                "label": "submitted_at (B)"
              },
              {
                "name": "name",
                "type": "text",
                "label": "name (C)"
              },
              {
                "name": "email",
                "type": "text",
                "label": "email (D)"
              },
              {
                "name": "company",
                "type": "text",
                "label": "company (E)"
              },
              {
                "name": "service",
                "type": "text",
                "label": "service (F)"
              },
              {
                "name": "message",
                "type": "text",
                "label": "message (G)"
              },
              {
                "name": "owner",
                "type": "text",
                "label": "owner (H)"
              },
              {
                "name": "intake_status",
                "type": "text",
                "label": "intake_status (I)"
              },
              {
                "name": "notified_at",
                "type": "text",
                "label": "notified_at (J)"
              }
            ],
            "type": "collection",
            "label": "Values in columns",
            "metadata": [
              [
                [
                  "submission_id",
                  "submitted_at",
                  "name",
                  "email",
                  "company",
                  "service",
                  "message",
                  "owner",
                  "intake_status",
                  "notified_at"
                ]
              ]
            ]
          }
        ],
        "advanced": true
      },
      "onerror": [
        {
          "id": 10,
          "module": "builtin:Break",
          "version": 1,
          "parameters": {},
          "mapper": {
            "count": "3",
            "retry": false,
            "interval": "15"
          },
          "metadata": {
            "designer": {
              "x": 1200,
              "y": 300,
              "name": "Review failure before retry"
            },
            "restore": {
              "expect": {
                "retry": {
                  "mode": "chose"
                }
              }
            },
            "expect": [
              {
                "name": "retry",
                "type": "boolean",
                "label": "Retry automatically",
                "required": true
              },
              {
                "name": "count",
                "type": "uinteger",
                "label": "Number of retries",
                "required": true,
                "validate": {
                  "max": 10000,
                  "min": 1
                }
              },
              {
                "name": "interval",
                "type": "uinteger",
                "label": "Minutes between retries",
                "required": true,
                "validate": {
                  "max": 44640,
                  "min": 1
                }
              }
            ]
          }
        }
      ]
    },
    {
