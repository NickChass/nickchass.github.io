          "owner@example.com"
        ],
        "subject": "[FICTIONAL DEMO] {{2.owner}} \u2014 enquiry {{1.submission_id}}",
        "bodyType": "collection",
        "contents": [
          {
            "text": "<p><strong>Fictional Northstar Studio enquiry</strong></p><p>Owner: {{escapeHTML(2.owner)}}<br>Submission ID: {{escapeHTML(1.submission_id)}}<br>Submitted: {{escapeHTML(1.submitted_at)}}<br>Name: {{escapeHTML(trim(1.name))}}<br>Email: {{escapeHTML(2.normalized_email)}}<br>Company: {{escapeHTML(1.company)}}<br>Service: {{escapeHTML(1.service)}}</p><p><strong>Enquiry</strong></p><pre style=\"white-space:pre-wrap;font-family:Arial,sans-serif\">{{escapeHTML(1.message)}}</pre><p><a href=\"https://docs.google.com/spreadsheets/d/REPLACE_WITH_SPREADSHEET_ID/edit\">Open the demo enquiry register</a></p><p>Portfolio test using fictional data. No customer reply is required.</p>",
